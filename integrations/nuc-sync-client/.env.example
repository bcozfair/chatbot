# ปลายทางของ API — โดเมนสาธารณะของแชทบอท (ไม่ต้องต่อ LAN)
SYNC_API_URL=https://salechatbot.primus-iot.com

# กุญแจที่ออกจากฝั่งแชทบอทด้วย  npm run sync:key -- --name "NUC-Kay"
# แสดงครั้งเดียวตอนออก ทำหายต้องออกใหม่
SYNC_API_KEY=

# MongoDB ของ NUC เอง
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=salechatbot

# แถวต่อหน้า (เพดานฝั่งเซิร์ฟเวอร์คือ 2000)
PAGE_LIMIT=1000

# เผื่อเวลาถอยหลังตอนขึ้นรอบใหม่ (วินาที) — กัน transaction ที่ commit ช้ากว่าเวลาที่จับไว้
LAG_SECONDS=60

# ตารางที่ต้องไล่เทียบ id เพื่อลบตามต้นทาง · ต้นทางลบแถวจริงเฉพาะ quotations
RECONCILE_TABLES=quotations
RECONCILE_EVERY_MINUTES=60

# จำกัดว่าจะดึงเฉพาะตารางไหน (ว่าง = ทุกตารางที่กุญแจเห็น)
TABLES=
