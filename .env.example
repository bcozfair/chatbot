LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

DEEPSEEK_API_KEY=your_deepseek_api_key

LIFF_ID=your_liff_id
LIFF_QUOTE_ID=your_liff_quote_id
LIFF_PRODUCT_SEARCH_ID=your_liff_product_search_id

# รันแบบ Docker: PG_HOST ต้องเป็น "db" (ชื่อ service) — docker-compose override ให้อยู่แล้ว
# รันแบบ local (ไม่ใช้ Docker): ใช้ localhost
PG_HOST=db
PG_PORT=5432
PG_DATABASE=chatbot_primus
PG_USER=postgres
PG_PASSWORD=your_db_password

Product_full_sync=your_product_sync_key
Customer_full_sync=your_customer_sync_key
Saleorder_full_sync=your_saleorder_sync_key

gateway_host=http://localhost:5173/

JWT_SECRET=your_jwt_secret
NODE_ENV=development

# ค่าคงที่ของไฟล์นำเข้า Sale Order ของ Odoo (ระบบไม่ได้เก็บค่าเหล่านี้ในใบเสนอราคา)
# ทุกตัวมีค่าตั้งต้นในโค้ดแล้ว ไม่ตั้งก็รันได้ — ตั้งเมื่อชื่อใน Odoo ไม่ตรงกับค่าตั้งต้น
#
# ชื่อภาษีแยกตามบริษัท (QP = PM, QT = THT) เพราะเป็น Odoo คนละระบบ
# ⚠️ สองค่านี้ต่างกันแค่เว้นวรรคหน้าวงเล็บ และต่างกันจริงตามที่แต่ละระบบตั้งชื่อไว้
#    ห้ามแก้ให้เหมือนกัน — Odoo จับคู่ภาษีด้วยชื่อแบบตรงตัวทุกอักขระ ผิดตัวเดียวนำเข้าไม่ผ่านทั้งใบ
ODOO_EXPORT_TAX_QP="Output VAT 7% (Exc)"
ODOO_EXPORT_TAX_QT="Output VAT 7%(Exc)"
ODOO_EXPORT_SOURCE=Sales
ODOO_EXPORT_UOM=Pcs

# บันทึกการเรียก API (ตาราง api_logs) — ไว้ตรวจย้อนหลังว่าใครเรียกอะไร และหา endpoint ที่ช้า
# ปิดได้ทันทีด้วย false แล้ว restart (middleware จะ return ตั้งแต่บรรทัดแรก) — ค่าอื่นที่ไม่ใช่ "false" = เปิด
API_LOG_ENABLED=true
# จำนวนวันที่เก็บย้อนหลัง ตัวลบอัตโนมัติทำงานทุกชั่วโมง
# ⚠️ ห้ามต่ำกว่า 90 — พ.ร.บ.คอมพิวเตอร์ ม.26 บังคับให้เก็บข้อมูลจราจรไม่น้อยกว่า 90 วัน
#    ตั้ง 120 เพื่อกันเผื่อ: ตัวลบทำงานทุกชั่วโมงตามเวลาจริง ถ้าตั้ง 90 พอดีแล้ววันไหนตรวจช้า
#    ข้อมูลวันที่ 90 จะถูกลบไปแล้ว · ต้นทุนของส่วนเผื่อ 30 วันนี้คือ ~6 MB
# ค่าต่ำกว่า 1 หรืออ่านไม่ออกจะตกกลับเป็น 30 (ค่าตั้งต้นในโค้ด — ต่ำกว่ากฎหมาย ต้องตั้งค่านี้เสมอ)
API_LOG_RETENTION_DAYS=120

# ── logworker (โปรเซสแยกบน host — ไม่ได้อยู่ในคอนเทนเนอร์แอป) ─────────────────────────────
# ตัวเก็บ system log / เติมชื่อผู้แก้ไขให้ audit / สรุป traffic รายวัน
# แอปไม่รู้จักค่าเหล่านี้เลย · หยุด logworker แล้วแอปทำงานปกติทุกอย่าง
# ระดับต่ำสุดที่เขียนลงตาราง system_logs — ต่ำกว่านี้ยังอยู่ใน docker logs ตามเดิม
# fatal|error|warn|info|debug · ตั้ง warn เพื่อให้วันปกติโตหลัก kB แทนหลัก MB
SYSTEM_LOG_DB_LEVEL=warn
# ชื่อคอนเทนเนอร์ที่ให้ logworker อ่าน (คั่นด้วย comma)
SYSTEM_LOG_CONTAINERS=primus-chatbot-app-1
# จำนวนวันที่เก็บ system_logs · แยกกันระหว่างระดับ warn ขึ้นไป กับ info/debug
SYSTEM_LOG_RETENTION_DAYS=90
SYSTEM_LOG_INFO_RETENTION_DAYS=14
# จำนวนวันที่เก็บ audit_logs — 2 ปีตามอายุความและข้อ "ขยายได้ถึง 2 ปี" ของ ม.26
AUDIT_LOG_RETENTION_DAYS=730

# พอร์ตบน host ที่ผูกกับ 127.0.0.1 ให้ reverse proxy กลางของ IT วิ่งเข้ามา (Docker เท่านั้น)
# ถาม IT ว่าพอร์ตไหนว่าง แล้วแจ้งพอร์ตนี้ให้ IT ผูกกับ subdomain
APP_PORT=3011

# โดเมนสาธารณะที่ผู้ใช้เข้าถึงได้จริง (มี https:// นำหน้า ไม่ต้องมี / ปิดท้าย)
# ใช้ประกอบลิงก์ PDF ที่บอทส่งเข้าแชท LINE — ลูกค้าปลายทางกดจากมือถือ
#
# ⚠️ ต้องตั้งเสมอ ห้ามปล่อยว่าง
#    ถ้าว่าง แอปจะเดาค่าจาก Host header ของ webhook "ตัวแรก" ที่วิ่งเข้ามาหลัง container
#    เกิดใหม่ (index.ts ~176) แล้วล็อกค่านั้นไว้จนกว่าจะ recreate — ถ้าตัวแรกบังเอิญเป็น
#    curl ทดสอบจากในเครื่อง จะได้ http://127.0.0.1:3011 และลิงก์ทุกใบที่ส่งออกไป
#    หลังจากนั้นจะเปิดไม่ได้ทั้งหมด (เกิดขึ้นจริง 2026-08-20 — เสียไป 4 ใบ)
APP_URL=https://bot.company.com
